{
  "version": 1,
  "check": {
    "stopHook": "on-edit",
    "commands": [
      {
        "name": "main",
        "command": "./singbox-selfcheck.sh && ./tests/run.sh"
      },
      {
        "name": "doc",
        "command": "sdlc-doc lint"
      }
    ]
  },
  "fix": {
    "testGlobs": [
      "tests/**"
    ]
  },
  "docs": {
    "context7": {
      "libraries": {
        "sing-box": {
          "id": "/sagernet/sing-box",
          "version": "1.14.0",
          "commit": false
        }
      },
      "maxCallsPerWindow": 15
    },
    "guard": {
      "entry": "README.md",
      "extra": [
        "README.md",
        "CLAUDE.md"
      ]
    }
  }
}
