{
  "version": 1,
  "check": {
    "stopHook": "on-edit",
    "commands": [
      {
        "name": "main",
        "command": "./singbox-selfcheck.sh && ./tests/run.sh",
        "paths": [
          "singbox.sh",
          "singbox-selfcheck.sh",
          "tests/**"
        ]
      },
      {
        "name": "doc",
        "command": "sdlc-doc lint"
      }
    ]
  },
  "fix": {
    "testGlobs": [
      "tests/**"
    ]
  },
  "docs": {
    "context7": {
      "libraries": {
        "sing-box": {
          "id": "/sagernet/sing-box",
          "version": "1.14.0",
          "commit": true
        }
      },
      "maxCallsPerWindow": 15
    },
    "guard": {
      "entry": "README.md",
      "extra": [
        "README.md",
        "CLAUDE.md",
        "AGENTS.md",
        "CONTRIBUTING.md"
      ]
    },
    "site": {
      "url": "https://claude.ai/code/artifact/159d07a2-1cdd-4e82-b921-452128721268"
    }
  },
  "release": {
    "channel": "release",
    "version": {
      "files": [
        {
          "path": "singbox.sh",
          "pattern": "^VERSION=\"(.*)\"$"
        }
      ]
    },
    "assets": [
      "singbox.sh"
    ]
  },
  "contracts": {
    "files": [
      ".github/workflows/release.yml"
    ]
  }
}
