{
  "version": 1,
  "check": {
    "command": "./singbox-selfcheck.sh && ./tests/selfcheck.test.sh",
    "stopHook": "off"
  },
  "fix": {
    "testGlobs": [
      "tests/**"
    ]
  },
  "docs": {
    "context7": {
      "libraries": {
        "sing-box": {
          "id": "/sagernet/sing-box",
          "version": "1.13.14",
          "commit": false
        }
      },
      "maxCallsPerWindow": 15,
      "keyFile": "~/.config/context7/sdlc-key"
    }
  }
}
