#!/usr/bin/env bash
#
# 假 sing-box 内核。不是 PATH 桩——singbox.sh 从来不按名字找 sing-box，
# 它调的永远是 "$BIN" 或沙箱位上的绝对路径。所以这份是**模板**，测试用
# sed 把 __VERSION__ 换成具体版本号后装到那两个位置上去。
#
# 「装在哪」决定行为：$0 等于 $SB_FAKE_LIVE_BIN 就是现网位，否则是沙箱位。
# 阶段 1 与阶段 2 跑的是同一个二进制、同一份配置，只有位置不同——要让这两处
# 能分别失败，判据只能是位置。
#
# 驱动变量（都可不设）：
#   SB_FAKE_CHECK_FAIL=<sandbox|live|all>:<版本>   check -c 失败
#   SB_FAKE_RUN_FAIL=<版本>                        run 起不来（沙箱实跑）
#   SB_FAKE_RUN_SQUAT=1                            run 吐完日志后不自己监听，而是让**另一个
#                                                  进程**占住那个端口，自己活 3 秒退出——模拟
#                                                  并发的另一个 singbox.sh 抢先绑了同一个空闲端口
#   SB_FAKE_DEPRECATED=<版本>                      check 输出里带废弃字段告警
#   SB_FAKE_ARCH=<amd64|arm64>                     version 里报告的架构
#   SB_FAKE_SCHEMA=<路径>                          schema 子命令吐哪份 JSON
#   SB_FAKE_CHECK_NOISE=1                          check 退 1，但输出**不是内核诊断**
#                                                  （模拟 sudo 要密码、wrapper 脚本、
#                                                  SIP 拦截这类「审查本身没做成」）
#
# SB_FAKE_SCHEMA 不是「绕过 PATH 桩」那类后门（见 singbox.sh:1521 / 1563 的两条注释，
# 那说的是内联 python3 自己去联网，桩拦不住）。schema 是被 "$BIN" 调起来的外部命令，
# 桩完全拦得住；这个变量只是给桩**指路**——模板被 sed 复制到临时目录后，
# $0 已经不在仓库里，读不到 tests/fixtures/ 的相对路径。
#
SB_SELF_VERSION="__VERSION__"

_pos() { [ "$0" = "${SB_FAKE_LIVE_BIN:-}" ] && echo live || echo sandbox; }

# "<位置>:<版本>" 是否命中当前这次调用
_hits() {
  local spec="$1" want_pos="${1%%:*}" want_ver="${1##*:}"
  [ -z "$spec" ] && return 1
  [ "$want_ver" = "$SB_SELF_VERSION" ] || return 1
  [ "$want_pos" = all ] || [ "$want_pos" = "$(_pos)" ]
}

case "${1:-}" in
  version)
    echo "sing-box version $SB_SELF_VERSION"
    echo
    echo "Environment: go1.26.5 darwin/${SB_FAKE_ARCH:-$( [ "$(uname -m)" = arm64 ] && echo arm64 || echo amd64 )}"
    echo "Tags: with_gvisor,with_quic"
    echo "CGO: enabled"
    exit 0
    ;;
  check)
    [ "${SB_FAKE_DEPRECATED:-}" = "$SB_SELF_VERSION" ] && \
      echo "WARN[0000] deprecated: option domain_strategy is deprecated in sing-box 1.14.0"
    if _hits "${SB_FAKE_CHECK_FAIL:-}"; then
      echo "FATAL[0000] decode config at ${3:-?}: unknown field ${SB_FAKE_UNKNOWN_FIELD:-domain_strategy}" >&2
      exit 1
    fi
    # 按配置内容判，跟真内核同一个口径。三种反应各自对应发现层的一档：
    #   已移除字段  → FATAL 退 1        （check 档，tier=removed）
    #   废弃仍接受  → WARN + migration  （check 档，tier=deprecated）
    #   download_detour → **一个字都不打**
    # 最后那条是本功能的成因，桩必须还原这份沉默：桩要是对它出声，
    # 「schema 档补上 check 档盲区」这条断言就永远是假绿——它会从 check 档走掉。
    # 「审查没做成」与「内核拒绝配置」必须能分开测。这一档退非 0 但一个字都不像
    # 内核诊断 —— 调用方若把它当成发现，就会把「审不了」报成「配置已经坏了」。
    [ "${SB_FAKE_CHECK_NOISE:-}" = 1 ] && {
      echo "sudo: a terminal is required to read the password" >&2; exit 1; }
    _cfg=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -c) [ -n "${2:-}" ] || { echo "fake sing-box: -c 需要参数" >&2; exit 2; }
            _cfg="$2"; shift 2 ;;
        *)  shift ;;
      esac
    done
    if [ -n "$_cfg" ] && [ -f "$_cfg" ]; then
      if grep -q '"inet4_address"' "$_cfg"; then
        echo "FATAL[0000] decode config at ${_cfg}: unknown field inet4_address" >&2
        exit 1
      fi
      for _dep in store_rdrc independent_cache; do
        grep -q "\"${_dep}\"" "$_cfg" && echo "WARN[0000] legacy ${_dep} option is deprecated in sing-box 1.14.0 and will be removed in sing-box 1.16.0, checkout documentation for migration: https://sing-box.sagernet.org/migration/#${_dep}"
      done
    fi
    exit 0
    ;;
  schema)
    [ -n "${SB_FAKE_SCHEMA:-}" ] && [ -f "$SB_FAKE_SCHEMA" ] || {
      echo "fake sing-box: schema 需要 SB_FAKE_SCHEMA 指向一份 JSON" >&2; exit 2; }
    cat "$SB_FAKE_SCHEMA"
    exit 0
    ;;
  run)
    [ "${SB_FAKE_RUN_FAIL:-}" = "$SB_SELF_VERSION" ] && {
      echo "FATAL[0000] start service: bind: address already in use" >&2; exit 1; }
    # SB_FAKE_RUN_LOG=<路径>：把这份日志原样吐到 stderr，模拟内核 Start() 阶段的 WARN。
    # config audit 的沙箱日志档（D 路）就是从这里收割的；真内核的 WARN 只在实跑时才打。
    [ -n "${SB_FAKE_RUN_LOG:-}" ] && [ -f "$SB_FAKE_RUN_LOG" ] && cat "$SB_FAKE_RUN_LOG" >&2
    # 真的把配置里的 mixed 端口占住：沙箱探测要先等端口起来，
    # 不占的话那段等待就是在等一个永远不会发生的事件。
    cfg=""
    while [ $# -gt 0 ]; do case "$1" in -c) cfg="${2:-}"; shift 2 ;; *) shift ;; esac; done
    if [ "${SB_FAKE_RUN_SQUAT:-}" = 1 ]; then
      # 端口由别的 pid 占住（8 秒后自灭），本进程等它听起来后再活 3 秒退出。
      # 探测方若只看「端口有人听」就会把这当成建链成功；看 pid 的才知道不是自己的。
      python3 - "$cfg" <<'PY' &
import json, socket, sys, time
d = json.load(open(sys.argv[1]))
p = next(int(i.get("listen_port", 0)) for i in d.get("inbounds", []) if i.get("type") in ("mixed", "socks"))
s = socket.socket(); s.bind(("127.0.0.1", p)); s.listen(16); time.sleep(8)
PY
      python3 - "$cfg" <<'PY'
import json, socket, sys, time
d = json.load(open(sys.argv[1]))
p = next(int(i.get("listen_port", 0)) for i in d.get("inbounds", []) if i.get("type") in ("mixed", "socks"))
for _ in range(50):
    if socket.socket().connect_ex(("127.0.0.1", p)) == 0: break
    time.sleep(0.1)
time.sleep(3)
PY
      exit 0
    fi
    exec python3 - "$cfg" <<'PY'
import json, socket, sys, time
ports = []
try:
    d = json.load(open(sys.argv[1]))
    for i in d.get("inbounds", []):
        if i.get("type") in ("mixed", "socks"):
            ports.append(int(i.get("listen_port", 0))); break
    # clash_api 的 external_controller 也是一个真实的监听——现网实例占着它的时候，
    # 第二个实例就是死在这里。桩不还原这一点，派生逻辑漏删 clash_api 也测不出来。
    ec = d.get("experimental", {}).get("clash_api", {}).get("external_controller")
    if ec:
        ports.append(int(str(ec).rsplit(":", 1)[-1]))
except Exception:
    pass
socks = []
for p in ports:
    if not p:
        continue
    s = socket.socket(); s.bind(("127.0.0.1", p)); s.listen(16); socks.append(s)
time.sleep(600)
PY
    ;;
esac
echo "fake sing-box: 未实现的子命令 ${1:-}" >&2
exit 2
