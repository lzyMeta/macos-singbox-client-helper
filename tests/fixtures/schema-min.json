{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sing-box.sagernet.org/schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "examples": [
        "https://sing-box.sagernet.org/schema.json"
      ]
    },
    "log": {},
    "dns": {
      "$ref": "#/$defs/DNSOptions"
    },
    "ntp": {},
    "certificate": {},
    "certificate_providers": {},
    "http_clients": {},
    "network_namespaces": {},
    "endpoints": {},
    "inbounds": {},
    "outbounds": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "tag": {}
            }
          },
          {
            "$ref": "#/$defs/HysteriaOutbound"
          }
        ]
      }
    },
    "route": {
      "$ref": "#/$defs/RouteOptions"
    },
    "services": {},
    "experimental": {
      "$ref": "#/$defs/ExperimentalOptions"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "RouteOptions": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Rule"
          }
        },
        "rule_set": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleSet"
          }
        },
        "final": {
          "type": "string",
          "x-tag-reference": "outbound"
        },
        "find_process": {
          "type": "boolean"
        },
        "find_neighbor": {
          "type": "boolean"
        },
        "dhcp_lease_files": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "auto_detect_interface": {
          "type": "boolean"
        },
        "override_android_vpn": {
          "type": "boolean"
        },
        "default_interface": {
          "type": "string"
        },
        "default_mark": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "string"
            }
          ]
        },
        "default_domain_resolver": {
          "$ref": "#/$defs/DomainResolver"
        },
        "default_network_strategy": {
          "type": "string",
          "enum": [
            "default",
            "fallback",
            "hybrid"
          ]
        },
        "default_network_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterfaceType"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/InterfaceType"
              }
            }
          ]
        },
        "default_fallback_network_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterfaceType"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/InterfaceType"
              }
            }
          ]
        },
        "default_fallback_delay": {
          "$ref": "#/$defs/Duration"
        },
        "default_http_client": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RuleSet": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "inline",
                ""
              ]
            },
            "tag": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "rules": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "tag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "local"
            },
            "tag": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "format": {
              "type": "string",
              "enum": [
                "source",
                "binary"
              ]
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "tag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "remote"
            },
            "tag": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "format": {
              "type": "string",
              "enum": [
                "source",
                "binary"
              ]
            },
            "url": {
              "type": "string"
            },
            "initial_path": {
              "type": "string"
            },
            "http_client": {
              "$ref": "#/$defs/HTTPClientReference"
            },
            "update_interval": {
              "$ref": "#/$defs/Duration"
            }
          },
          "required": [
            "type",
            "tag"
          ],
          "additionalProperties": false
        }
      ]
    },
    "HTTPClientReference": {
      "anyOf": [
        {
          "type": "string",
          "x-tag-reference": "http_client"
        },
        {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "enum": [
                "go",
                "apple"
              ]
            },
            "headers": {},
            "tls": {},
            "detour": {
              "type": "string",
              "x-tag-reference": "outbound"
            },
            "connect_timeout": {
              "$ref": "#/$defs/Duration"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Duration": {
      "type": "string",
      "pattern": "^[-+]?(((\\d+(\\.\\d*)?|\\.\\d+)(ns|us|µs|μs|ms|s|m|h|d))+|0)$"
    },
    "ExperimentalOptions": {
      "type": "object",
      "properties": {
        "cache_file": {
          "$ref": "#/$defs/CacheFileOptions"
        },
        "clash_api": {
          "$ref": "#/$defs/ClashAPIOptions"
        },
        "v2ray_api": {},
        "debug": {}
      },
      "additionalProperties": false
    },
    "ClashAPIOptions": {
      "type": "object",
      "properties": {
        "external_controller": {
          "type": "string"
        },
        "external_ui": {
          "type": "string"
        },
        "external_ui_download_url": {
          "type": "string"
        },
        "external_ui_download_detour": {
          "type": "string",
          "x-tag-reference": "outbound"
        },
        "secret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DNSRule": {
      "oneOf": [
        {
          "type": "object",
          "unevaluatedProperties": false,
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "default",
                    ""
                  ]
                },
                "inbound": {},
                "ip_version": {
                  "type": "integer",
                  "enum": [
                    4,
                    6
                  ]
                },
                "query_type": {},
                "network": {},
                "auth_user": {},
                "protocol": {},
                "domain": {},
                "domain_suffix": {},
                "domain_keyword": {},
                "domain_regex": {},
                "source_ip_cidr": {},
                "source_ip_is_private": {},
                "ip_cidr": {},
                "ip_is_private": {},
                "ip_accept_any": {},
                "source_port": {},
                "source_port_range": {},
                "port": {},
                "port_range": {},
                "process_name": {},
                "process_path": {},
                "process_path_regex": {},
                "package_name": {},
                "user": {},
                "user_id": {},
                "clash_mode": {},
                "network_type": {},
                "network_is_expensive": {},
                "network_is_constrained": {},
                "interface_address": {},
                "wifi_ssid": {},
                "wifi_bssid": {},
                "rule_set": {},
                "rule_set_ip_cidr_match_source": {},
                "match_response": {
                  "type": "boolean"
                },
                "response_rcode": {},
                "response_answer": {},
                "response_ns": {},
                "response_extra": {},
                "invert": {
                  "type": "boolean"
                }
              }
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "const": "route"
                    },
                    "server": {
                      "type": "string"
                    },
                    "disable_cache": {},
                    "rewrite_ttl": {},
                    "client_subnet": {},
                    "speculative": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "evaluate"
                    },
                    "server": {},
                    "tag": {},
                    "disable_cache": {},
                    "rewrite_ttl": {},
                    "client_subnet": {},
                    "speculative": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "respond"
                    },
                    "tag": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "reject"
                    },
                    "method": {
                      "type": "string",
                      "enum": [
                        "",
                        "default",
                        "drop",
                        "reply"
                      ]
                    },
                    "no_drop": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "predefined"
                    },
                    "rcode": {},
                    "answer": {},
                    "ns": {},
                    "extra": {}
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "allOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "logical"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "and",
                    "or"
                  ]
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/DNSRule"
                  }
                },
                "invert": {}
              }
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "const": "route"
                    },
                    "server": {
                      "type": "string"
                    },
                    "disable_cache": {},
                    "rewrite_ttl": {},
                    "client_subnet": {},
                    "speculative": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "evaluate"
                    },
                    "server": {},
                    "tag": {},
                    "disable_cache": {},
                    "rewrite_ttl": {},
                    "client_subnet": {},
                    "speculative": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "respond"
                    },
                    "tag": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "reject"
                    },
                    "method": {
                      "type": "string",
                      "enum": [
                        "",
                        "default",
                        "drop",
                        "reply"
                      ]
                    },
                    "no_drop": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "predefined"
                    },
                    "rcode": {},
                    "answer": {},
                    "ns": {},
                    "extra": {}
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "DNSOptions": {
      "type": "object",
      "properties": {
        "servers": {},
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DNSRule"
          }
        },
        "final": {},
        "strategy": {},
        "disable_cache": {},
        "disable_expire": {},
        "cache_capacity": {},
        "reverse_mapping": {},
        "client_subnet": {},
        "timeout": {},
        "optimistic": {}
      },
      "additionalProperties": false
    },
    "CacheFileOptions": {
      "type": "object",
      "properties": {
        "enabled": {},
        "path": {},
        "cache_id": {},
        "store_fakeip": {},
        "store_dns": {
          "type": "boolean"
        },
        "rdrc_timeout": {}
      },
      "additionalProperties": false
    },
    "HysteriaOutbound": {
      "type": "object",
      "properties": {
        "type": {
          "const": "hysteria"
        },
        "tag": {},
        "server": {},
        "server_port": {},
        "server_ports": {},
        "hop_interval": {},
        "up": {},
        "up_mbps": {},
        "down": {},
        "down_mbps": {},
        "obfs": {},
        "auth": {},
        "auth_str": {},
        "network": {},
        "tls": {},
        "quic": {},
        "detour": {},
        "bind_interface": {},
        "inet4_bind_address": {},
        "inet6_bind_address": {},
        "routing_mark": {},
        "reuse_addr": {},
        "connect_timeout": {},
        "tcp_fast_open": {},
        "tcp_multi_path": {},
        "udp_fragment": {},
        "domain_resolver": {},
        "network_strategy": {},
        "network_type": {},
        "fallback_network_type": {},
        "fallback_delay": {}
      },
      "additionalProperties": false
    },
    "Rule": {
      "oneOf": [
        {
          "type": "object",
          "unevaluatedProperties": false,
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "default",
                    ""
                  ]
                },
                "inbound": {},
                "ip_version": {},
                "network": {},
                "protocol": {},
                "domain": {},
                "domain_suffix": {},
                "domain_keyword": {},
                "domain_regex": {},
                "source_ip_cidr": {},
                "ip_cidr": {},
                "ip_is_private": {},
                "source_port": {},
                "port": {},
                "process_name": {},
                "rule_set": {},
                "rule_set_ip_cidr_match_source": {},
                "invert": {},
                "clash_mode": {}
              }
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "const": "route"
                    },
                    "outbound": {
                      "type": "string"
                    },
                    "network_strategy": {
                      "type": "string",
                      "enum": [
                        "default",
                        "fallback",
                        "hybrid"
                      ]
                    },
                    "udp_connect": {},
                    "udp_timeout": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "reject"
                    },
                    "method": {
                      "type": "string",
                      "enum": [
                        "",
                        "default",
                        "drop",
                        "reply"
                      ]
                    },
                    "no_drop": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "sniff"
                    },
                    "sniffer": {},
                    "timeout": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "hijack-dns"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "allOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "logical"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "and",
                    "or"
                  ]
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Rule"
                  }
                },
                "invert": {}
              }
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "const": "route"
                    },
                    "outbound": {
                      "type": "string"
                    },
                    "network_strategy": {
                      "type": "string",
                      "enum": [
                        "default",
                        "fallback",
                        "hybrid"
                      ]
                    },
                    "udp_connect": {},
                    "udp_timeout": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "reject"
                    },
                    "method": {
                      "type": "string",
                      "enum": [
                        "",
                        "default",
                        "drop",
                        "reply"
                      ]
                    },
                    "no_drop": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "sniff"
                    },
                    "sniffer": {},
                    "timeout": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "hijack-dns"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
